<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lesson.schedule.mapper.StudentMapper">

    <sql id="Base_Column_List">
        id, name, grade, phone, parent_wechat, address, price, status, color, remark, create_time, update_time
    </sql>

    <!-- 列表 + 搜索：keyword 匹配 姓名/电话，grade 精确，status 精确 -->
    <select id="listByCondition" resultType="com.lesson.schedule.entity.Student">
        SELECT <include refid="Base_Column_List"/>
        FROM student
        <where>
            <if test="keyword != null and keyword != ''">
                AND (name LIKE CONCAT('%', #{keyword}, '%')
                     OR phone LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="grade != null and grade != ''">
                AND grade = #{grade}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY id DESC
    </select>
</mapper>
