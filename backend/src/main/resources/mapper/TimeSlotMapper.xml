<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lesson.schedule.mapper.TimeSlotMapper">

    <sql id="Base_Column_List">
        id, start_time, end_time, sort_order, enabled, create_time, update_time
    </sql>

    <!-- 按开始时间升序返回全部时段（顺序由起止时间决定，不提供手工排序） -->
    <select id="listOrdered" resultType="com.lesson.schedule.entity.TimeSlot">
        SELECT <include refid="Base_Column_List"/>
        FROM time_slot
        ORDER BY start_time ASC, id ASC
    </select>

    <!-- 重叠校验辅助：与 [startTime, endTime) 交叉且启用，可排除自身 -->
    <select id="selectOverlapping" resultType="com.lesson.schedule.entity.TimeSlot">
        SELECT <include refid="Base_Column_List"/>
        FROM time_slot
        WHERE enabled = 1
          AND start_time &lt; #{endTime}
          AND end_time &gt; #{startTime}
        <if test="excludeId != null">
            AND id != #{excludeId}
        </if>
    </select>
</mapper>
