<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lesson.schedule.mapper.CourseMapper">

    <sql id="Base_Column_List">
        id, student_id, subject, price, remark, enabled, create_time, update_time
    </sql>

    <!-- 每生唯一一条语文课 -->
    <select id="selectByStudentId" resultType="com.lesson.schedule.entity.Course">
        SELECT <include refid="Base_Column_List"/>
        FROM course
        WHERE student_id = #{studentId}
        LIMIT 1
    </select>

    <select id="countByStudentId" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM course WHERE student_id = #{studentId}
    </select>
</mapper>
